+import type {JudgeOutput,RuleConfig} from '@court/shared'
+/** Checks provenance, not truth. Image transcripts require human/pixel verification. */
+export function validateCards(o:JudgeOutput,sources:Record<string,string>,rules:RuleConfig){
+ const cards=o.evidenceCards||[]
+ const ids=new Set<string>(), events=new Set<string>()
+ for(const c of cards){
+  if(ids.has(c.id))throw new Error('重复证据卡ID');ids.add(c.id)
+  const d=o.dimensions.find(d=>d.id===c.dimensionId),g=d?.[c.side]
+  if(!g||g.score!==c.score||!g.refs.includes(c.ref))throw new Error('证据卡与评分不一致')
+  if(!Object.hasOwn(sources,c.ref)||c.ref==='context.participation'||c.ref.endsWith('.consent'))throw new Error('证据卡来源无效')
+  if(c.ref.startsWith('image:')){
+   if(c.kind!=='image_transcription'||c.verification!=='needs_image_review')throw new Error('截图转写必须标记待核验')
+  }else if(c.verification!=='text_match'||c.kind==='image_transcription'||!sources[c.ref].includes(c.quote))throw new Error('引文不在原文中')
+  // A participant statement cannot be relabelled as a verified chat transcript.
+  else if(c.kind!=='statement')throw new Error('当前文本来源均为陈述，不能伪装聊天原文')
+  if(c.score>0){
+   if(!c.behaviorId||!g.behaviorIds.includes(c.behaviorId))throw new Error('证据卡行为无效')
+   const event=c.side+'|'+c.ref+'|'+c.quote
+   if(events.has(event))throw new Error('同一原话重复计分');events.add(event)
+  }else if(c.behaviorId!==null)throw new Error('零分不得绑定过错行为')
+ }
+ if(rules.version==='2.0.0'&&!o.safety.detected)for(const d of o.dimensions)for(const side of ['A','B'] as const){
+  const g=d[side]
+  if(g.score!==null&&!cards.some(c=>c.side===side&&c.dimensionId===d.id))throw new Error('可评分维度缺少证据卡')
+  if(g.score!==null&&g.score>0&&g.behaviorIds.some(b=>!cards.some(c=>c.side===side&&c.dimensionId===d.id&&c.behaviorId===b)))throw new Error('过错行为缺少证据卡')
+ }
+ for(const h of o.highlights||[]){
+  if(h.evidenceIds.some(id=>!ids.has(id)))throw new Error('趣味卡引用不存在')
+  if(/渣男|渣女|神经病|人格障碍|你就是|天生就是/.test(h.text))throw new Error('趣味卡不能羞辱人格')
+ }
+}

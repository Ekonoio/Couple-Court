+import {describe,it,expect} from 'vitest'
+import {getRules,summarize} from '../packages/court-rules/src/index'
+import {validateOutput,completeJudgment,buildJudgePromptWithSystem,mockOutput} from '../packages/judge/src/core'
+import type {JudgeOutput,Material} from '../packages/shared/src/index'
+import fs from 'node:fs'
+const rules=getRules('2.0.0')
+const st=(happened:string)=>({why:'',happened,disagreement:'',discomfort:'',ownFault:'',resolution:''})
+const material:Material={mode:'same_device',basics:{title:'虚构：约定与表达',cause:'',course:'双方确认以下文本用于测试。',outcome:''},statements:{A:st('我临时改了约定，忘记通知你。我没有说你不在乎我。我不骂你。我愿意重新约时间。'),B:st('我知道你忘了通知。我不猜你动机。我不骂你。我同意重新约时间。')},evidence:[]}
+const quotes={A:['我临时改了约定，忘记通知你。','我没有说你不在乎我。','我不骂你。','我愿意重新约时间。'],B:['我知道你忘了通知。','我不猜你动机。','我不骂你。','我同意重新约时间。']}
+export function example():JudgeOutput{
+ return {facts:[{category:'agreed',text:'双方确认甲方临时改约未通知。',refs:['A.happened','B.happened']}],dimensions:rules.dimensions.map((d,i)=>({id:d.id,A:{score:i===0?2:0,reason:i===0?'明确临时改约未通知，造成不便；未见更严重后果。':'已审查本片段该维度，未见明显过错。',refs:['A.happened'],behaviorIds:i===0?['change-appointment']:[]},B:{score:0,reason:'已审查本片段该维度，未见明显过错。',refs:['B.happened'],behaviorIds:[]}})),reasoning:[{text:'仅就本次改约认定甲方的具体过错。',refs:['A.happened','B.happened']}],reasonable:{A:[],B:[]},uncertainties:[],suggestions:{A:['下次改约前先发消息确认新的时间。'],B:['说明这次等待造成的不便，再决定是否接受新时间。']},keyFactsSufficient:true,seriousFaults:[],safety:{detected:false,message:'',refs:[]},commentary:null,labels:[],evidenceCards:rules.dimensions.flatMap((d,i)=>(['A','B'] as const).map(side=>({id:`${side}-${d.id}`,speaker:side,side,dimensionId:d.id,quote:quotes[side][i],ref:`${side}.happened`,kind:'statement' as const,verification:'text_match' as const,reason:side==='A'&&i===0?'改约未通知对应行为维度2分；此卡不另加分。':'本段是该方陈述，与其余材料一同审查；未见该维明显过错。',score:side==='A'&&i===0?2:0,behaviorId:side==='A'&&i===0?'change-appointment':null}))),highlights:[{kind:'rewrite',text:'我临时有变动，原定时间来不了。你看改到明晚可以吗？',evidenceIds:['A-conduct']}]}
+}
+describe('v2证据契约与边界',()=>{
+ it('示例通过真实业务校验并独立相加',()=>{const o=validateOutput(example(),material,rules);expect(summarize(o,rules)).toEqual({totals:{A:2,B:0},verdict:'A'})})
+ it('正的低分不再判无错',()=>{expect(summarize(example(),rules).verdict).toBe('A')})
+ it('双零为none，同正分为close，双方高分不被归一',()=>{const o=example();o.dimensions[0].A.score=0;expect(summarize(o,rules).verdict).toBe('none');for(const d of o.dimensions){d.A.score=5;d.B.score=5}expect(summarize(o,rules)).toEqual({totals:{A:20,B:20},verdict:'close'})})
+ it.each(['evidenceCards','highlights'] as const)('v2拒绝缺少%s',field=>{const o=example();delete o[field];expect(()=>validateOutput(o,material,rules)).toThrow()})
+ it.each([-1,6,1.2])('拒绝非法卡片分数%s',score=>{const o=example();o.evidenceCards![0].score=score;expect(()=>validateOutput(o,material,rules)).toThrow()})
+ it('拒绝编造引文',()=>{const o=example();o.evidenceCards![0].quote='不存在的话';expect(()=>validateOutput(o,material,rules)).toThrow('引文')})
+ it('拒绝角色陈述假冒聊天记录',()=>{const o=example();o.evidenceCards![0].kind='chat';expect(()=>validateOutput(o,material,rules)).toThrow('伪装')})
+ it('拒绝证据卡与维度分数不一致',()=>{const o=example();o.evidenceCards![0].score=4;expect(()=>validateOutput(o,material,rules)).toThrow('不一致')})
+ it('拒绝缺少零分证据与有分数项缺卡',()=>{const o=example();o.evidenceCards!.pop();expect(()=>validateOutput(o,material,rules)).toThrow('缺少证据卡')})
+ it('拒绝同原话换ID重复计分',()=>{const o=example();const c=o.evidenceCards![0];o.evidenceCards!.push({...c,id:'duplicate'});expect(()=>validateOutput(o,material,rules)).toThrow('重复计分')})
+ it('拒绝不存在的卡片引用',()=>{const o=example();o.highlights![0].evidenceIds=['invented'];expect(()=>validateOutput(o,material,rules)).toThrow('引用不存在')})
+ it('不允许证据未知项看起来为完整总分',()=>{const o=example();o.dimensions[0].A.score=null;o.dimensions[0].A.behaviorIds=[];o.evidenceCards=o.evidenceCards!.filter(c=>c.id!=='A-conduct');o.highlights=[];expect(summarize(validateOutput(o,material,rules),rules)).toEqual({totals:{A:null,B:0},verdict:'insufficient'})})
+ it('关键事实不足时清理趣味内容并隐藏总分',()=>{const o=example();o.keyFactsSufficient=false;const j=completeJudgment(o,material,rules,{source:'manual',provider:'test',model:'fixture',promptVersion:'test',durationMs:0,usage:null,estimatedCost:null});expect(j.totals).toEqual({A:null,B:null});expect(j.output.highlights).toEqual([])})
+ it('安全模式不排名不玩梗',()=>{const o=example();o.safety={detected:true,message:'有具体威胁，先确保安全。',refs:['A.happened']};const v=validateOutput(o,material,rules);expect(v.evidenceCards).toEqual([]);expect(v.highlights).toEqual([]);expect(summarize(v,rules).verdict).toBe('safety');expect(v.dimensions.every(d=>d.A.score===null&&d.B.score===null)).toBe(true)})
+ it('截图转写不能声称文本匹配已核验',()=>{const m=structuredClone(material);m.evidence=[{id:'image1',owner:'A',left:'A',right:'B',position:0,note:''}];const o=example();o.dimensions[0].A.refs=['image:image1'];o.evidenceCards![0]={...o.evidenceCards![0],ref:'image:image1',kind:'image_transcription'};expect(()=>validateOutput(o,m,rules)).toThrow('待核验');o.evidenceCards![0].verification='needs_image_review';expect(validateOutput(o,m,rules).evidenceCards![0].verification).toBe('needs_image_review')})
+ it('Mock v2保持null并通过契约',()=>{const o=validateOutput(mockOutput(material,rules),material,rules);expect(summarize(o,rules).verdict).toBe('insufficient')})
+ it('输出Schema枚举固定维度并限制长度',()=>{const p=buildJudgePromptWithSystem(material,rules,'test');expect(JSON.stringify(p.jsonSchema)).toContain('evidenceCards');expect(JSON.stringify(p.jsonSchema)).toContain('conduct')})
+ it('语料声明虚构、来源及预期边界齐全',()=>{const cases=JSON.parse(fs.readFileSync('tests/cases/court-v2.json','utf8'));expect(cases.length).toBeGreaterThanOrEqual(10);for(const c of cases){expect(c.synthetic).toBe(true);expect(c.id).toBeTruthy();expect(c.messages.length).toBeGreaterThan(0);expect(c.expectation).toBeTruthy()}})
+})
+
+it('v2沿用旧mock语料时不伪造新契约证据',async()=>{
+ const {runJudge}=await import('../packages/judge/src/index')
+ const old=example();delete old.evidenceCards;delete old.highlights
+ const j=await runJudge(material,rules,{mode:'mock',model:'test',provider:'test',baseUrl:'https://example.com'},[],old)
+ expect(j.verdict).toBe('insufficient');expect(j.output.evidenceCards).toEqual([])
+})
+it('例子、固定规则与导出Schema同步且JSON Schema可校验',()=>{
+ const Ajv=require('ajv');const ajv=new Ajv({allErrors:true})
+ // Installed skill is tested through project-contained copies in portable test runs.
+ const schema=JSON.parse(fs.readFileSync('packages/judge/contracts/output.schema.json','utf8'))
+ const output=JSON.parse(fs.readFileSync('packages/judge/contracts/example.json','utf8'))
+ expect(ajv.validate(schema,output)).toBe(true)
+ expect(validateOutput(output,material,rules).dimensions.length).toBe(4)
+ output.evidenceCards[0].score=6;expect(ajv.validate(schema,output)).toBe(false)
+})

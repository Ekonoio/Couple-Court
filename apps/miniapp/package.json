{
  "name": "@court/miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:h5": "cross-env TARO_APP_DEVTOOLS=1 taro build --disable-global-config --type h5 --watch",
    "dev:weapp": "cross-env TARO_APP_DEVTOOLS=1 taro build --disable-global-config --type weapp --watch",
    "build:h5": "node ../../scripts/clean-build.mjs h5 && cross-env TARO_APP_DEVTOOLS=0 taro build --disable-global-config --type h5",
    "build:h5:dev": "node ../../scripts/clean-build.mjs h5 && cross-env TARO_APP_DEVTOOLS=1 taro build --disable-global-config --type h5",
    "build:weapp": "node ../../scripts/clean-build.mjs weapp && cross-env TARO_APP_DEVTOOLS=0 taro build --disable-global-config --type weapp && node ../../scripts/configure-weapp.mjs"
  },
  "dependencies": {
    "@court/shared": "0.1.0",
    "@tarojs/components": "4.1.9",
    "@tarojs/helper": "4.1.9",
    "@tarojs/plugin-framework-react": "4.1.9",
    "@tarojs/plugin-platform-h5": "4.1.9",
    "@tarojs/plugin-platform-weapp": "4.1.9",
    "@tarojs/react": "4.1.9",
    "@tarojs/router": "^4.1.9",
    "@tarojs/runtime": "4.1.9",
    "@tarojs/shared": "4.1.9",
    "@tarojs/taro": "4.1.9",
    "@tarojs/taro-h5": "^4.1.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.1.9",
    "@tarojs/webpack5-runner": "4.1.9",
    "babel-preset-taro": "4.1.9",
    "cross-env": "7.0.3",
    "dotenv": "17.2.2",
    "react-refresh": "0.14.2",
    "sass": "1.92.1",
    "webpack": "5.91.0"
  }
}

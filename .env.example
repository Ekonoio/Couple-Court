# Node 24；复制为根目录 .env。默认不调用任何付费服务。
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
DB_PATH=.data/court.sqlite
DATA_RETENTION_DAYS=7
COURT_RULES_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:10086,http://127.0.0.1:10086,http://localhost:3001,http://127.0.0.1:3001

# mock 或 real；real 需要支持图片及 JSON Schema 的 OpenAI Chat Completions 兼容接口
LLM_MODE=mock
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# 可选，美元/百万 token；空值显示费用不可用，不猜测费率。
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
# 可选；开发模式未设置时自动生成 .data/dev-token，前端不自动获取。
DEV_ACCESS_TOKEN=

# 前端编译时设置：微信真机需改成可访问且合法的 HTTPS 服务地址。
# TARO_APP_API_BASE=https://your-authorized-api.example
# WEAPP_APPID=your-appid
